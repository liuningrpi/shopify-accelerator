# Shopify Configuration (Legacy format - for create-orders.js)
SHOP=your-shop.myshopify.com

# Shopify Configuration (New format - for shopifyClient.js)
SHOP_DOMAIN=your-shop.myshopify.com
ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Example:
# SHOP=nanrui-store.myshopify.com
# SHOP_DOMAIN=nanrui-store.myshopify.com
# ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# KDocs API Configuration
KDOCS_APP_ID=your_app_id
KDOCS_APP_SECRET=your_app_secret
KDOCS_URL=https://www.kdocs.cn/l/xxxxxxxxxx
KDOCS_RANGE=B10:I23
KDOCS_OUTPUT=./kdocs-export.csv
KDOCS_AUTH_CODE=
KDOCS_ACCESS_TOKEN=
KDOCS_REFRESH_TOKEN=
KDOCS_FILE_TOKEN=

# CSV Processing Configuration
TRANSLATE_VARIANTS=true
